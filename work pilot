<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>salik - Find Jobs & Earn Online</title>
<meta name="description" content="salik an online freelancing and remote jobs platform. Discover opportunities, build skills and grow your career.">
<meta name="keywords" content="salik, online jobs, freelancing, remote work, online earning">
<meta name="author" content=salik">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
:root {
  --bg:#0b1120;
  --card:#131d30;
  --card2:#18243a;
  --text:#f4f7ff;
  --muted:#9aa9c2;
  --accent:#55e6bd;
  --blue:#638cff;
  --border:rgba(255,255,255,.09);
}

* {margin:0;padding:0;box-sizing:border-box}

html {scroll-behavior:smooth}

body {
  font-family:Inter,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.6;
}

a {text-decoration:none;color:inherit}
button,input,select {font:inherit}
button {cursor:pointer}

.container {
  width:min(1150px,92%);
  margin:auto;
}

header {
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(11,17,32,.94);
  backdrop-filter:blur(18px);
  border-bottom:1px solid var(--border);
}

.nav {
  min-height:76px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.logo {
  font:700 27px "Space Grotesk",sans-serif;
  letter-spacing:-1px;
}

.logo span {color:var(--accent)}

.nav-links {
  display:flex;
  align-items:center;
  gap:27px;
  color:var(--muted);
  font-size:14px;
}

.nav-links a:hover {color:var(--accent)}

.nav-actions {
  display:flex;
  align-items:center;
  gap:12px;
}

.btn {
  border:0;
  padding:12px 19px;
  border-radius:9px;
  font-weight:700;
  transition:.2s;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
}

.btn:hover {transform:translateY(-2px)}

.primary {
  background:var(--accent);
  color:#071b18;
}

.secondary {
  background:transparent;
  border:1px solid var(--border);
  color:white;
}

.menu-btn {
  display:none;
  color:white;
  background:none;
  border:0;
  font-size:23px;
}

.hero {
  padding:105px 0 85px;
  background:
    radial-gradient(ellipse at 80% 20%,rgba(85,230,189,.12),transparent 40%),
    radial-gradient(ellipse at 15% 70%,rgba(99,140,255,.13),transparent 35%);
}

.hero-grid {
  display:grid;
  grid-template-columns:1.2fr .8fr;
  align-items:center;
  gap:55px;
}

.tag {
  display:inline-block;
  color:var(--accent);
  border:1px solid rgba(85,230,189,.25);
  background:rgba(85,230,189,.07);
  padding:8px 14px;
  border-radius:30px;
  font-size:12px;
  font-weight:700;
  margin-bottom:22px;
}

.hero h1 {
  font:700 clamp(40px,6vw,68px)/1.12 "Space Grotesk",sans-serif;
  letter-spacing:-2.5px;
  margin-bottom:22px;
}

.hero h1 span {color:var(--accent)}

.hero p {
  color:var(--muted);
  max-width:590px;
  font-size:16px;
  margin-bottom:28px;
}

.hero-buttons {
  display:flex;
  gap:13px;
  flex-wrap:wrap;
}

.hero-card {
  background:linear-gradient(145deg,#192943,#111c30);
  border:1px solid var(--border);
  border-radius:22px;
  padding:28px;
  box-shadow:0 25px 80px rgba(0,0,0,.3);
}

.hero-card h3 {
  font:600 22px "Space Grotesk";
  margin-bottom:20px;
}

.mini-job {
  display:flex;
  align-items:center;
  gap:13px;
  padding:15px 0;
  border-bottom:1px solid var(--border);
}

.mini-job:last-child {border:0}

.job-icon {
  width:45px;
  height:45px;
  display:grid;
  place-items:center;
  background:rgba(85,230,189,.1);
  color:var(--accent);
  border-radius:12px;
  flex-shrink:0;
}

.mini-job strong {display:block;font-size:14px}
.mini-job small {color:var(--muted)}

.price {
  margin-left:auto;
  color:var(--accent);
  font-weight:700;
  white-space:nowrap;
}

.stats {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
  margin-top:50px;
}

.stat {
  background:rgba(255,255,255,.035);
  border:1px solid var(--border);
  border-radius:13px;
  padding:20px;
}

.stat h2 {
  font:700 28px "Space Grotesk";
  color:var(--accent);
}

.stat p {font-size:12px;color:var(--muted)}

section {padding:85px 0}

.section-head {
  text-align:center;
  margin-bottom:42px;
}

.section-head h2 {
  font:700 clamp(29px,4vw,42px) "Space Grotesk";
  margin-bottom:12px;
}

.section-head p {color:var(--muted)}

.categories {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}

.category {
  background:var(--card);
  border:1px solid var(--border);
  border-radius:15px;
  padding:26px 20px;
  transition:.25s;
}

.category:hover {
  transform:translateY(-5px);
  border-color:var(--accent);
}

.category i {
  font-size:25px;
  color:var(--accent);
  margin-bottom:18px;
}

.category h3 {font-size:16px;margin-bottom:6px}
.category p {font-size:12px;color:var(--muted)}

.jobs-section {background:#0e1728}

.job-controls {
  display:flex;
  gap:12px;
  margin-bottom:28px;
  flex-wrap:wrap;
}

.job-controls input,.job-controls select {
  background:var(--card);
  border:1px solid var(--border);
  color:white;
  padding:13px;
  border-radius:9px;
  outline:none;
  flex:1;
  min-width:180px;
}

.job-controls select option {background:var(--card)}

.job-list {
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:17px;
}

.job-card {
  background:var(--card);
  border:1px solid var(--border);
  padding:23px;
  border-radius:15px;
  transition:.2s;
}

.job-card:hover {border-color:var(--accent)}

.job-top {
  display:flex;
  align-items:center;
  gap:13px;
  margin-bottom:15px;
}

.company-icon {
  width:48px;
  height:48px;
  display:grid;
  place-items:center;
  border-radius:12px;
  background:var(--card2);
  color:var(--accent);
  font-size:20px;
}

.job-top h3 {font-size:16px}
.job-top small {color:var(--muted)}

.job-card p {
  color:var(--muted);
  font-size:13px;
  margin:13px 0;
}

.job-tags {
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin:14px 0;
}

.job-tags span {
  font-size:11px;
  color:var(--accent);
  background:rgba(85,230,189,.08);
  padding:6px 10px;
  border-radius:6px;
}

.job-bottom {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  border-top:1px solid var(--border);
  padding-top:15px;
}

.job-bottom strong {color:var(--accent);font-size:15px}
.job-bottom button {padding:9px 13px;font-size:12px}

.steps {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.step {
  background:var(--card);
  border:1px solid var(--border);
  padding:30px;
  border-radius:15px;
}

.step-number {
  font:700 32px "Space Grotesk";
  color:var(--accent);
  margin-bottom:15px;
}

.step h3 {margin-bottom:10px}
.step p {color:var(--muted);font-size:13px}

.pricing {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.plan {
  background:var(--card);
  border:1px solid var(--border);
  padding:28px;
  border-radius:16px;
}

.plan.featured {border-color:var(--accent)}

.plan h3 {font-size:19px}
.plan .amount {
  font:700 34px "Space Grotesk";
  margin:18px 0;
}

.plan p {color:var(--muted);font-size:13px}

.plan ul {
  list-style:none;
  margin:22px 0;
}

.plan li {
  padding:8px 0;
  font-size:13px;
  color:var(--muted);
}

.plan li i {color:var(--accent);margin-right:8px}

.plan .btn {width:100%}

.cta {
  background:linear-gradient(120deg,#143b3b,#192d53);
  border:1px solid var(--border);
  border-radius:22px;
  padding:55px 25px;
  text-align:center;
}

.cta h2 {
  font:700 36px "Space Grotesk";
  margin-bottom:12px;
}

.cta p {color:#c0d0df;margin-bottom:25px}

footer {
  border-top:1px solid var(--border);
  padding:35px 0;
}

.footer-content {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  flex-wrap:wrap;
}

.footer-content p {color:var(--muted);font-size:12px}

.socials {display:flex;gap:16px;color:var(--muted)}
.socials a:hover {color:var(--accent)}

.modal {
  display:none;
  position:fixed;
  inset:0;
  z-index:500;
  background:rgba(0,0,0,.75);
  align-items:center;
  justify-content:center;
  padding:18px;
}

.modal.show {display:flex}

.modal-box {
  background:#152239;
  border:1px solid var(--border);
  border-radius:17px;
  padding:28px;
  width:min(430px,100%);
  position:relative;
}

.modal-box h2 {margin-bottom:8px}
.modal-box p {color:var(--muted);font-size:13px;margin-bottom:20px}

.modal-box input,.modal-box select {
  display:block;
  width:100%;
  padding:13px;
  margin-bottom:13px;
  border-radius:8px;
  border:1px solid var(--border);
  background:#0c1629;
  color:white;
  outline:none;
}

.modal-box .btn {width:100%}

.close {
  position:absolute;
  right:18px;
  top:15px;
  border:0;
  background:none;
  color:white;
  font-size:23px;
}

.toast {
  position:fixed;
  bottom:25px;
  right:25px;
  background:var(--accent);
  color:#071b18;
  padding:13px 20px;
  border-radius:9px;
  font-weight:700;
  display:none;
  z-index:600;
}

.toast.show {display:block}

.empty {
  grid-column:1/-1;
  color:var(--muted);
  text-align:center;
  padding:30px;
}

@media(max-width:850px) {
  .hero-grid {grid-template-columns:1fr}
  .categories {grid-template-columns:repeat(2,1fr)}
  .stats {grid-template-columns:repeat(2,1fr)}
  .job-list {grid-template-columns:1fr}
  .pricing {grid-template-columns:1fr}
}

@media(max-width:650px) {
  .nav-links {
    display:none;
    position:absolute;
    top:76px;
    left:0;
    width:100%;
    background:#101b2d;
    padding:22px;
    flex-direction:column;
    align-items:flex-start;
    border-bottom:1px solid var(--border);
  }

  .nav-links.open {display:flex}
  .menu-btn {display:block}
  .nav-actions .secondary {display:none}
  .hero {padding:75px 0 55px}
  section {padding:65px 0}
  .steps {grid-template-columns:1fr}
  .categories {gap:10px}
  .category {padding:19px 14px}
  .hero h1 {letter-spacing:-1.5px}
  .cta h2 {font-size:28px}
}
</style>
</head>

