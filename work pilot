<div class="modal" id="authModal">
  <div class="modal-box">
    <button class="close" onclick="closeModal()">&times;</button>

    <h2 id="modalTitle">Create Account</h2>
    <p id="modalDescription">Join salik and explore opportunities.</p>

    <form id="authForm">
      <input type="text" id="fullName" placeholder="Your Full Name">
      <input type="email" id="email" placeholder="Email Address" required>
      <input type="password" id="password" placeholder="Password" required minlength="6">

      <button class="btn primary" type="submit" id="authSubmit">
        Create Account
      </button>
    </form>

    <p style="margin-top:17px;text-align:center">
      <span id="switchText">Already have an account?</span>
      <a href="javascript:void(0)" onclick="switchMode()" style="color:var(--accent)">
        <span id="switchLink">Login</span>
      </a>
    </p>

    <small style="color:var(--muted)">
      Demo interface only. Secure account registration requires a backend.
    </small>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>

const jobs = [
  {
    title:"Frontend Web Developer",
    company:"Digital Studio",
    category:"Development",
    type:"Remote",
    salary:"$300 - $500",
    icon:"fa-code",
    description:"Build responsive websites using HTML, CSS and JavaScript.",
    tags:["HTML","CSS","JavaScript"]
  },
  {
    title:"Graphic Designer",
    company:"Creative Agency",
    category:"Design",
    type:"Freelance",
    salary:"$150 - $250",
    icon:"fa-palette",
    description:"Create modern logos, banners and social media designs.",
    tags:["Photoshop","Figma","Branding"]
  },
  {
    title:"SEO Specialist",
    company:"Growth Media",
    category:"Marketing",
    type:"Part Time",
    salary:"$200 - $350",
    icon:"fa-chart-line",
    description:"Improve search engine visibility and website performance.",
    tags:["SEO","Analytics","Research"]
  },
  {
    title:"Content Writer",
    company:"Media House",
    category:"Writing",
    type:"Remote",
    salary:"$100 - $200",
    icon:"fa-pen-nib",
    description:"Write informative articles, website content and blogs.",
    tags:["Writing","Blogs","Research"]
  },
  {
    title:"AI Automation Developer",
    company:"Future Labs",
    category:"AI",
    type:"Freelance",
    salary:"$400 - $700",
    icon:"fa-robot",
    description:"Create automation workflows and AI-powered solutions.",
    tags:["AI","Automation","APIs"]
  },
  {
    title:"Mobile App Developer",
    company:"AppWorks",
    category:"Development",
    type:"Remote",
    salary:"$500 - $800",
    icon:"fa-mobile-screen",
    description:"Develop user-friendly mobile applications.",
    tags:["Flutter","Android","Mobile"]
  }
];

let isLogin = false;

function renderJobs() {
  const search = document.getElementById("searchInput")
    .value.toLowerCase();

  const category = document.getElementById("categoryFilter").value;
  const type = document.getElementById("typeFilter").value;

  const filtered = jobs.filter(job => {
    const matchesSearch =
      (job.title + " " + job.company + " " +
      job.description + " " + job.tags.join(" "))
      .toLowerCase().includes(search);

    const matchesCategory = !category || job.category === category;
    const matchesType = !type || job.type === type;

    return matchesSearch && matchesCategory && matchesType;
  });

  const list = document.getElementById("jobList");

  if (!filtered.length) {
    list.innerHTML = '<div class="empty">No matching jobs found. Try another search.</div>';
    return;
  }

  list.innerHTML = filtered.map(job => `
    <article class="job-card">
      <div class="job-top">
        <div class="company-icon">
          <i class="fa-solid ${job.icon}"></i>
        </div>
        <div>
          <h3>${job.title}</h3>
          <small>${job.company}</small>
        </div>
      </div>

      <p>${job.description}</p>

      <div class="job-tags">
        ${job.tags.map(tag => `<span>${tag}</span>`).join("")}
        <span>${job.type}</span>
      </div>

      <div class="job-bottom">
        <strong>${job.salary}</strong>
        <button class="btn primary"
          onclick="applyJob('${job.title.replace(/'/g,"\\'")}')">
          Apply Now
        </button>
      </div>
    </article>
  `).join("");
}

function applyJob(title) {
  showToast("Please login to apply for: " + title);
  openModal("login");
}

function openModal(mode) {
  isLogin = mode === "login";

  document.getElementById("authModal").classList.add("show");
  document.getElementById("modalTitle").textContent =
    isLogin ? "Welcome Back" : "Create Account";

  document.getElementById("modalDescription").textContent =
    isLogin ? "Login to your WorkPilot account." :
    "Join WorkPilot and explore opportunities.";

  document.getElementById("fullName").style.display =
    isLogin ? "none" : "block";

  document.getElementById("fullName").required = !isLogin;

  document.getElementById("authSubmit").textContent =
    isLogin ? "Login" : "Create Account";

  document.getElementById("switchText").textContent =
    isLogin ? "Don't have an account?" : "Already have an account?";

  document.getElementById("switchLink").textContent =
    isLogin ? "Sign Up" : "Login";
}

function closeModal() {
  document.getElementById("authModal").classList.remove("show");
}

function switchMode() {
  openModal(isLogin ? "signup" : "login");
}

document.getElementById("authForm").addEventListener("submit", function(e) {
  e.preventDefault();

  const email = document.getElementById("email").value;
  const name = document.getElementById("fullName").value;

  if (isLogin) {
    showToast("Demo only: connect a backend for real login.");
  } else {
    showToast("Demo only: connect a backend to register " + name + ".");
  }

  this.reset();
  closeModal();
});

function showToast(message) {
  const toast = document.getElementById("toast");
  toast.textContent = message;
  toast.classList.add("show");

  setTimeout(() => {
    toast.classList.remove("show");
  }, 3000);
}

function toggleMenu() {
  document.getElementById("navLinks").classList.toggle("open");
}

document.querySelectorAll(".nav-links a").forEach(link => {
  link.addEventListener("click", () => {
    document.getElementById("navLinks").classList.remove("open");
  });
});

document.getElementById("authModal").addEventListener("click", function(e) {
  if (e.target === this) closeModal();
});

document.getElementById("year").textContent = new Date().getFullYear();

renderJobs();

</script>

</body>
</html>
